{
  "manifest_version": 3,
  "name": "LNZ Feed Filter",
  "version": "0.3.0",
  "description": "Reads TikTok's preloaded For You feed and media passively, classifies locally, and skips stressful videos.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "LNZ" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "web_accessible_resources": [{ "resources": ["model-host.html"], "matches": ["https://www.tiktok.com/*"] }],
  "commands": {
    "toggle-autoscroll": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Toggle auto-scroll" },
    "toggle-overlay": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "Toggle debug overlay" }
  },
  "content_scripts": [
    { "matches": ["https://www.tiktok.com/*"], "js": ["injected.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://www.tiktok.com/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ]
}
