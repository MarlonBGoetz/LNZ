{
  "manifest_version": 3,
  "name": "LNZ",
  "short_name": "LNZ",
  "version": "0.1.0",
  "description": "Take control of your short-form video feed. AI filters for Calm, Learn and Shield, locked with your PIN.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LNZ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "preview.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:*/*", "http://127.0.0.1:*/*"],
  "minimum_chrome_version": "116"
}
